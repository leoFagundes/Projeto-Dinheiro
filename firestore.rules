rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /transactions/{transactionId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /categoryGoals/{goalId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /categoryGoalOverrides/{overrideId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /categories/{categoryId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /banks/{bankId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /pockets/{pocketId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /pocketMovements/{movementId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /bankPayments/{paymentId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /bankTransfers/{transferId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /pocketTransfers/{transferId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /investments/{investmentId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /investmentMovements/{movementId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /patrimonioSnapshots/{snapshotId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    match /investmentGoals/{userId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Documento único por usuário (id = uid), guarda preferências de conta
    // como o tema (claro/escuro/sistema) — sem `userId` no corpo, a
    // propriedade é o próprio id do documento bater com quem está logado.
    match /userPreferences/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Feedback (Ajustes → Feedback): o usuário só cria, nunca lê de volta.
    // Leitura/gestão (mudar status, excluir) só pelo SDK Admin em /admin,
    // que ignora estas regras — por isso não há allow read/update/delete aqui.
    match /feedback/{feedbackId} {
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    // Ranking + carteira de moedas do easter egg (id = uid, como
    // userPreferences): leitura aberta pra qualquer usuário logado, porque
    // o ranking é COMPARTILHADO entre contas (o app decide no cliente quais
    // abas de modo mostrar pra cada um, não dá pra restringir campo a campo
    // aqui). Escrita só pelo dono, em um de dois caminhos: (a) terminar uma
    // partida — a pontuação de CADA modo em pontuacoesPorModo só sobe, moedas
    // só sobem — ou (b) comprar um item na loja — moedas descem, mas só se
    // ganhou exatamente 1 item novo em itensComprados. Não valida o preço
    // exato contra o catálogo (confia no cliente pra isso, como o resto do
    // app já faz — não é dinheiro de verdade).
    match /gameScores/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid;
      // .get(campo, padrão) em vez de leitura direta: documentos criados
      // antes de um campo existir não têm essa chave, e ler uma chave
      // ausente direto (resource.data.moedas) derruba a regra inteira —
      // negando tudo, mesmo uma atualização que nem mexe nesse campo. Os 3
      // modos são fixos (lib/game-modes.ts) — por isso checados um a um em
      // vez de percorrer o mapa dinamicamente (a linguagem das regras não
      // itera chaves de mapa).
      allow update: if request.auth != null && request.auth.uid == uid && (
        (
          request.resource.data.get('pontuacoesPorModo', {}).get('classico', 0)
            >= resource.data.get('pontuacoesPorModo', {}).get('classico', 0)
          && request.resource.data.get('pontuacoesPorModo', {}).get('oscilante', 0)
            >= resource.data.get('pontuacoesPorModo', {}).get('oscilante', 0)
          && request.resource.data.get('pontuacoesPorModo', {}).get('caotico', 0)
            >= resource.data.get('pontuacoesPorModo', {}).get('caotico', 0)
          && request.resource.data.moedas >= resource.data.get('moedas', 0)
        )
        ||
        (request.resource.data.moedas < resource.data.get('moedas', 0)
          && request.resource.data.itensComprados.size() == resource.data.get('itensComprados', []).size() + 1)
      );
    }
  }
}
